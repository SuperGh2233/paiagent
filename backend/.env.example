# 服务器配置
SERVER_PORT=8084

# 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=paiagent
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password_here

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO 配置
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000

# JWT 配置（必须修改！建议使用 32 字符以上的随机字符串）
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_change_this_in_production

# 单操作员开发账户（当前没有注册接口）
# 留空时登录会被禁用；本地运行前请自行设置用户名和强密码
APP_AUTH_DEFAULT_USERNAME=
APP_AUTH_DEFAULT_PASSWORD=

# OpenAI 配置（可选，节点配置可覆盖）
OPENAI_API_KEY=sk-your-openai-api-key-here
